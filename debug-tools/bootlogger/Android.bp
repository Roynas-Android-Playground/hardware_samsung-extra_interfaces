cc_binary {
    name: "logger",
    srcs: [
        "AuditToAllow.cpp",
        "KernelConfig.cpp",
        "Logger.cpp",
        "LoggerUtils.cpp",
    ],
    init_rc: ["logger.rc"],
    cflags: [
        "-Wall",
        "-Wextra",
    ],
    whole_static_libs: [
        "libbase",
        "libc++fs",
    ],
    shared_libs: [
        "liblog",
        "libz",
    ],
    system_ext_specific: true,
}
